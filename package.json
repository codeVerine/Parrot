{
  "name": "parrot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "orchestrate": "tsx src/orchestrate.ts",
    "orchestrate:next": "pnpm --filter @platform/orchestrator orchestrate",
    "build": "pnpm -r run build",
    "typecheck": "pnpm run build && pnpm -r run typecheck && tsc --noEmit",
    "test": "pnpm -r run test"
  },
  "dependencies": {
    "@platform/contracts": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
