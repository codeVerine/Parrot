{
  "name": "@platform/orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "parrot": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "orchestrate": "tsx src/cli.ts",
    "test": "pnpm --filter @platform/contracts build && pnpm --filter @platform/persistence build && pnpm --filter @platform/llm-boundary build && pnpm --filter @platform/workflow-engine build && pnpm --filter @platform/human-loop build && pnpm --filter @platform/herdr-adapter build && node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@platform/contracts": "workspace:*",
    "@platform/herdr-adapter": "workspace:*",
    "@platform/human-loop": "workspace:*",
    "@platform/llm-boundary": "workspace:*",
    "@platform/persistence": "workspace:*",
    "@platform/workflow-engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
